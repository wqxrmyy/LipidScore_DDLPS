# ============================================================================
# Liposarcoma V2 — reproducibility repository
#
# Scope: analysis code + governance locks + environment info ONLY.
# Excluded by decision: manuscript text, figures, internal work snapshots,
# third-party data, R session state.
#
# Rationale: project decision "code-only public release" (D4/D21).
# How the commit history was reconstructed: see PROVENANCE.md.
#
# Guarded by scripts/00_repo_hygiene/check_hygiene.py — run it before pushing.
# ============================================================================

# ---------- Manuscript text (MUST stay out: plagiarism-corpus risk) ---------
manuscript/
*.docx
*.doc
*.html
*.htm
*.tex
*.rtf
*.odt

# ---------- Figures (MUST stay out: figure-library risk) --------------------
results/figures/
*.pdf
*.tif
*.tiff
*.eps
*.png
*.jpg
*.jpeg

# ---------- Internal working snapshots (contain internal artefacts) ---------
reproducibility/logs/
_work/
_internal/
_backup_*/

# ---------- Third-party data (re-download from GEO; see README) -------------
data/

# ---------- R / RStudio session state ---------------------------------------
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.Renviron

# ---------- OS / editor -----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# ---------- Generated results -------------------------------------------------
# Excluded under the code-only release decision. The tables behind every number
# in the manuscript are available from the corresponding author on request, and
# are regenerated by run_all.sh.
# To publish them instead, comment the next line out and re-run check_hygiene.py.
results/
